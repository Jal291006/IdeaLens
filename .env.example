# Server Port
PORT=5000

# MongoDB Connection String (e.g. mongodb://localhost:27017/projectshield or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/projectshield

# GitHub Personal Access Token (Classic token with public repo read access, elevates rate limit to 5000/hr)
GITHUB_TOKEN=

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=
